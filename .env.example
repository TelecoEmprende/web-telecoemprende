ADMIN_PASSWORD=cambia_esta_contraseña
FLASK_SECRET_KEY=genera_una_clave_secreta_larga
CERTBOT_EMAIL=admin@telecoemprende.es
POSTGRES_PASSWORD=cambia_este_password

# Opcional: email automático al aceptar/rechazar una inscripción (backend/services/email.py).
# Si se deja vacío, el envío se salta en silencio y el panel funciona igual.
RESEND_API_KEY=
RESEND_FROM_EMAIL=inscripciones@telecoemprende.es
RESEND_FROM_NAME=TelecoEmprende

# Avisos a Slack cuando se crea una tarea o cambia de estado.
# Se saca de: Slack > tu app > Incoming Webhooks > Add New Webhook to Workspace.
# Si se deja vacío, no se envía nada y todo lo demás funciona igual.
SLACK_WEBHOOK_URL=

# Secreto que manda Vercel Cron en el header Authorization al avisar de
# deadlines de mañana (ver vercel.json > crons y backend/api/cron.py).
# Genera uno cualquiera (openssl rand -hex 32); en local no hace falta.
CRON_SECRET=
